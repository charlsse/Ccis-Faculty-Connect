APP_NAME=CCISFacultyConnect
APP_ENV=local
APP_CIPHER=AES-256-CBC
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false 
APP_TIMEZONE=Asia/Manila
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ccis_connect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FacultyConnect"

ACCOUNT_INVITATION_EXPIRE_MINUTES=1440
TEMPORARY_PASSWORD_HOURS=48
EMAIL_CHANGE_EXPIRE_MINUTES=60
FACULTYCONNECT_SUPPORT_EMAIL=support@example.edu
TRUSTED_DEVICE_DAYS=20
TRUSTED_DEVICE_COOKIE=facultyconnect_trusted_device
FACULTYCONNECT_LOOKUP_KEY=
MYSQLDUMP_BINARY=C:\xampp\mysql\bin\mysqldump.exe
MYSQL_BINARY=C:\xampp\mysql\bin\mysql.exe

VITE_APP_NAME="${APP_NAME}"

# Enable only after verifying the configured real mail transport.
WATER_EMAIL_ENABLED=false

# Optional PayMongo TEST integration. Use an isolated database of test contributions.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_PROVIDER=paymongo
PAYMENT_GATEWAY_SANDBOX_DATA_CONFIRMED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional Xendit Payment Sessions TEST preparation; keep disabled on recovered data.
# PAYMENT_GATEWAY_PROVIDER=xendit (use only in a separate synthetic test environment)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_TREASURER_ACCOUNT_CONFIRMED=false
XENDIT_TEST_DATABASE=
# Exact assigned ngrok hostname; public routes are restricted to webhook and return.
TUNNEL_ENABLED=false
TUNNEL_HOST=
